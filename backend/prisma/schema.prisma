generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model WorkoutPlan {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  level       String
  goal        String
  type        String
}